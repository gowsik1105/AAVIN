# ==============================================================================
# AAVIN SANGAM (ஆவின் சங்கம்) - Environment Variables Configuration Template
# ==============================================================================
# IMPORTANT:
# - Fill in your project credentials from your Supabase Project Settings -> API.
# - NEVER commit your real secrets, passwords, or service_role keys to Git.
# - In frontend/browser environments, use ONLY the public anon key.
# ==============================================================================

# Supabase Project URL (e.g., https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Public Anonymous API Key (Safe for client-side use with RLS enabled)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-public-key-here
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-public-key-here

# Local Development Server Configuration
PORT=8080
HOST=localhost

# Configured Admin Notification Alert Receivers
TAMIL_NADU_ADMIN_EMAIL=gowsik1105@gmail.com
DISTRICT_ADMIN_EMAIL=aavindis@admin.com
SANGAM_ADMIN_EMAIL=aavinsangam@admin.com

# Brevo (formerly Sendinblue) SMTP Configuration (For Real Member Registration Email OTP)
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=your_brevo_smtp_login_here
BREVO_SMTP_PASSWORD=your_brevo_smtp_master_or_api_key_here
BREVO_FROM_EMAIL=noreply@aavin.com
BREVO_FROM_NAME=AAVIN Main Dairy Management

# Optional: Brevo HTTP REST API Key (Alternative to SMTP)
BREVO_API_KEY=your_brevo_api_key_here

# Resend Email Delivery API (Fallback/Alternative)
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=Aavin Sangam <noreply@aavin.com>
