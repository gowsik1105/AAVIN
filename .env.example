# ==============================================================================
# AAVIN SANGAM (ஆவின் சங்கம்) - Environment Variables Configuration Template
# ==============================================================================
# IMPORTANT:
# - Fill in your project credentials from your Supabase Project Settings -> API.
# - NEVER commit your real secrets, passwords, or service_role keys to Git.
# - In frontend/browser environments, use ONLY the public anon key.
# ==============================================================================

# Supabase Project URL (e.g., https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Public Anonymous API Key (Safe for client-side use with RLS enabled)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-public-key-here
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-public-key-here

# Local Development Server Configuration
PORT=8080
HOST=localhost

# Configured Admin Notification Alert Receivers (Optional)
TAMIL_NADU_ADMIN_EMAIL=tn.admin@aavin.tn.gov.in
DISTRICT_ADMIN_EMAIL=district.admin@aavin.tn.gov.in
SANGAM_ADMIN_EMAIL=sangam.admin@aavin.tn.gov.in
